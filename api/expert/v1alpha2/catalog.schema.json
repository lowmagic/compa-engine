{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compa.lowmag.cc/expert/catalog/v1alpha2",
  "title": "Tool catalog manifest (catalog.yaml)",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "compa.lowmag.cc/expert/v1alpha2"
    },
    "kind": {
      "const": "Catalog"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://compa.lowmag.cc/expert/manifest/v1alpha2#/$defs/dottedId"
        },
        "version": {
          "$ref": "https://compa.lowmag.cc/expert/manifest/v1alpha2#/$defs/semver"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "engineApi",
        "tests"
      ],
      "additionalProperties": false,
      "properties": {
        "engineApi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://compa.lowmag.cc/expert/manifest/v1alpha2#/$defs/dottedId"
          }
        },
        "binaries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://compa.lowmag.cc/expert/manifest/v1alpha2#/$defs/binary"
          }
        },
        "captures": {
          "description": "The kinds of capture the catalog's tools read, each with the names of files or directories whose presence within an attachment marks one, and optionally the tool that identifies each capture of the kind (engine API 0.2.1). A catalog whose tools read any file declares none.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["kind", "marks"],
            "additionalProperties": false,
            "properties": {
              "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$"},
              "marks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[^/\\\\]{1,100}$"}
              },
              "identity": {
                "description": "The short name of this catalog's tool that identifies each capture of the kind beneath an attachment's directory, given as its parameter dir; its output is one compa.lowmag.cc/expert/identity/v1alpha2 object a line.",
                "$ref": "https://compa.lowmag.cc/expert/manifest/v1alpha2#/$defs/toolName"
              }
            }
          }
        }
      }
    }
  }
}
